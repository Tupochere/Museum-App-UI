GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Sulafat
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova
GOOGLE_CLOUD_TTS_KEY=
GOOGLE_CLOUD_TTS_VOICE=en-US-Neural2-F
GOOGLE_CLOUD_TTS_LANGUAGE=en-US
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# TTS_PROVIDER options: gemini | google_cloud | openai | elevenlabs
# If not set, auto-detects from which API keys are present.
# Default: gemini (uses the same GEMINI_API_KEY as text generation).
TTS_PROVIDER=gemini
# Google Cloud Function proxy URL (optional).
# When set, AI chat and TTS calls route through this Cloud Function
# instead of calling APIs directly. Eliminates free-tier rate limits.
CLOUD_FUNCTION_URL=
PAYCHANGU_SECRET_KEY=
PAYCHANGU_TEST_MODE=true
